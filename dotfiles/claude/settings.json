{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": { "effortLevel": "high" }
  },
  "theme": "custom:daltonized-dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "design@knowledge-work-plugins": true,
    "goldie@goldie": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": { "source": "github", "repo": "anthropics/knowledge-work-plugins" }
    },
    "goldie": {
      "source": { "source": "github", "repo": "kacperkapusciak/goldie" }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

# Copy to dotfiles/local.env (gitignored) and fill in.
#
# Machine- and account-specific values that must not be published live here,
# the same way names that must not be published live in .scan-denylist.
# scripts/install.sh and scripts/doctor.sh source this file when it exists.

# The Neovim configuration to clone into ~/.config/nvim. Keeping it as its own
# repository is the point — see dotfiles/nvim/README.md.
# NVIM_REPO=

# Where the Google Cloud SDK was unpacked, if it is not ~/google-cloud-sdk.
# GCLOUD_SDK_DIR=

# ~/.zprofile ──────────────────────────────────────────────────────────────
# Loaded ONCE per LOGIN shell, before ~/.zshrc.
# The place to initialise tools that only need setting up once per session.
# ──────────────────────────────────────────────────────────────────────────

# Homebrew (PATH, MANPATH, and the rest)
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# pyenv (Python version manager)
command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init --path)"

# Java. Resolved rather than pinned, so it survives a JDK upgrade and does not
# carry one machine's version into every other machine.
if [ -x /usr/libexec/java_home ]; then
  export JAVA_HOME="$(/usr/libexec/java_home 2>/dev/null)"
fi

# nvm (Node version manager). Node comes from here, not Homebrew, so a
# project's .nvmrc decides rather than the machine.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# ctags: prefer Homebrew's over the macOS stub, which is not the same program.
if command -v brew >/dev/null 2>&1; then
  alias ctags="$(brew --prefix)/bin/ctags"
fi
# Tag a project:  createTags
alias createTags="ctags --recurse=yes --exclude=.git"

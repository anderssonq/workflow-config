# Copy to ~/.secrets and fill in. NEVER commit the filled-in version.
#
# ~/.zshrc sources this file if it exists. Keeping every key in one place means
# there is exactly one file to keep out of version control, one file to back up,
# and one file to rotate from.
#
# Names only below — a real value in an example file is a real value in git.

# export ANTHROPIC_API_KEY=
# export OPENAI_API_KEY=
# export OPENCODE_API_KEY=     # read by the Neovim inline-completion module
# export GITHUB_TOKEN=

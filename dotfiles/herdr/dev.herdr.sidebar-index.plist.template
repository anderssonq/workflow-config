<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs sidebar-index.sh every 10 seconds.

  It used to be a `tab_bar_right` entry in config.toml — invisible, because the
  script prints nothing. herdr-radar owns that key now, so the periodic work
  moved here. If you need something on a timer alongside herdr, this is the
  shape; do not reach for `tab_bar_right` any more.

  launchd expands neither `~` nor `$HOME`, so every path has to be absolute.
  That is the only reason this is a template: scripts/install.sh substitutes
  {{ HOME }} and writes the result into ~/Library/LaunchAgents/. Committing the
  rendered file would put a username in a public repository.

  To remove it:
    launchctl bootout gui/$(id -u)/dev.herdr.sidebar-index
    rm ~/Library/LaunchAgents/dev.herdr.sidebar-index.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.herdr.sidebar-index</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ HOME }}/.config/herdr/sidebar-index.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with a minimal PATH, so the binary is named outright. -->
    <key>HERDR_BIN</key>
    <string>{{ HOME }}/.local/bin/herdr</string>
  </dict>

  <key>StartInterval</key>
  <integer>10</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardErrorPath</key>
  <string>{{ HOME }}/.local/state/herdr-sidebar-index/stderr.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
